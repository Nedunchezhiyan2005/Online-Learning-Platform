# Flask Configuration
FLASK_APP=app.py
FLASK_CONFIG=development
FLASK_DEBUG=True
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000

# Security Secrets (Generate a secure random string for production)
SECRET_KEY=dev-secret-key-change-in-production-devops-platform

# Database Connection (Default is SQLite in instance/ folder)
DATABASE_URL=sqlite:///instance/learning_platform.db

# Initial Administrator Credentials (Used by seed script and create-admin CLI)
ADMIN_NAME=Chief Administrator
ADMIN_EMAIL=admin@platform.edu
ADMIN_PASSWORD=AdminSecure2026!
